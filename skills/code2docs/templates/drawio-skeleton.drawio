<mxfile host="code2docs" type="device">
  <!-- One <diagram> per diagram. Copy the example cells' styles; delete the examples. -->
  <diagram id="diagram-1" name="Context">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Person / actor -->
        <mxCell id="actor_example" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="30" height="60" as="geometry" />
        </mxCell>
        <!-- System boundary (container=1); children use parent="boundary_example" and relative coordinates -->
        <mxCell id="boundary_example" value="System boundary" style="swimlane;startSize=24;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;container=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="440" height="260" as="geometry" />
        </mxCell>
        <!-- Internal container / process -->
        <mxCell id="process_example" value="Service&#xa;[Technology]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="boundary_example">
          <mxGeometry x="20" y="60" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Data store -->
        <mxCell id="store_example" value="Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="boundary_example">
          <mxGeometry x="260" y="50" width="120" height="80" as="geometry" />
        </mxCell>
        <!-- Queue / topic -->
        <mxCell id="queue_example" value="topic.name" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="boundary_example">
          <mxGeometry x="20" y="170" width="160" height="50" as="geometry" />
        </mxCell>
        <!-- File / document -->
        <mxCell id="file_example" value="export.csv" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="boundary_example">
          <mxGeometry x="260" y="170" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- External system -->
        <mxCell id="external_example" value="External System" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Labelled edges -->
        <mxCell id="edge_example_1" value="request [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="actor_example" target="process_example">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_example_2" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="boundary_example" source="process_example" target="store_example">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_example_3" value="calls [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="process_example" target="external_example">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
